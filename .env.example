# ---------------------------------------------------------------------------
# Bookends auth backend — copy to .env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Database -------------------------------------------------------------
# Neon (Vercel -> Storage -> Neon sets this for you on Vercel). Use the POOLED
# connection string — its host contains "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon and most managed Postgres need TLS. Set to "false" only for a local db.
DATABASE_SSL=true
# The server's certificate is verified. Set to "true" ONLY for a provider whose
# certificate chain Node does not trust (the link stays encrypted, unverified).
# DATABASE_SSL_NO_VERIFY=false
# Connections per server instance. Defaults to 1 on Vercel, 10 elsewhere.
# DATABASE_POOL_MAX=10

# --- JWT / session secrets -------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-64-char-random-string
REFRESH_TOKEN_SECRET=replace-me-with-a-different-64-char-random-string
# Only while rotating JWT_SECRET: put the OLD value here for a day, then remove.
# JWT_SECRET_PREVIOUS=
JWT_ISSUER=bookends-compliance
JWT_AUDIENCE=bookends-app

# Access token lifetime (short — it is refreshed silently by the frontend)
ACCESS_TOKEN_TTL=15m
# Refresh cookie lifetime in days (how long a phone stays signed in)
REFRESH_TOKEN_TTL_DAYS=30

# --- Passwords ------------------------------------------------------------
BCRYPT_ROUNDS=12
# Password handed out by the admin when creating/resetting an account.
DEFAULT_PASSWORD=1234
MIN_PASSWORD_LENGTH=8

# --- Brute-force protection ----------------------------------------------
MAX_FAILED_ATTEMPTS=8
LOCKOUT_MINUTES=15

# --- CORS -----------------------------------------------------------------
# Leave empty when Express serves index.html itself (same origin — recommended).
# Otherwise list the exact origins hosting the frontend, comma separated.
CORS_ORIGINS=

# --- Bootstrap admin (used by `npm run seed`) -----------------------------
SEED_ADMIN_UID=husen
SEED_ADMIN_NAME=Husen Khan
SEED_ADMIN_PASSWORD=change-this-before-seeding

# --- Vercel ---------------------------------------------------------------
# Sent by Vercel Cron to /api/cron/cleanup. 32+ random characters.
# CRON_SECRET=
# Vercel -> Storage -> Blob sets this. Without it, photos stay on the device.
# BLOB_READ_WRITE_TOKEN=

# --- One-time import from the old Supabase cloud sync (local .env ONLY) ----
# Used by `npm run import:supabase`. Never set these on Vercel, and delete the
# service_role key from this file once the import is done.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
